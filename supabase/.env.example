# Crux — Edge Function secrets.
# Copy to `.env` for local dev, or set with `supabase secrets set` in prod.
# NEVER commit the real values. The Anthropic key must live ONLY here (server).

# --- AI Coach (Anthropic primary, Gemini fallback) ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Razorpay (billing webhook) ---
RAZORPAY_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx

# --- OAuth providers (optional; enable in config.toml when ready) ---
SUPABASE_AUTH_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_GOOGLE_SECRET=
SUPABASE_AUTH_APPLE_CLIENT_ID=
SUPABASE_AUTH_APPLE_SECRET=

# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are injected
# automatically into deployed Edge Functions — do not set them here.
