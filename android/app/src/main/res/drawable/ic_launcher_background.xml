<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive-icon background: the Crux ember gradient (design token
     accent-hot #FF5C39 → #FF7A5C). Drawn as a shape so it stays crisp at
     every launcher size and mask shape. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:startColor="#FF7A5C"
        android:endColor="#FF5C39"
        android:angle="315" />
</shape>
